{
  "name": "arqweb",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npm run frontend:build && tsc",
    "commit": "cz",
    "dev": "tsx watch src/server.ts",
    "frontend:dev": "vite --config frontend/vite.config.ts --host 0.0.0.0",
    "frontend:build": "vue-tsc --noEmit -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "lint:commits": "commitlint",
    "release": "semantic-release",
    "start": "node dist/server.js",
    "test": "tsx --test tests/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "commitizen": "^4.3.2",
    "conventional-commits-filter": "^6.0.1",
    "cz-conventional-changelog": "^3.3.0",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "allowScripts": {
    "tsx@4.23.12": true,
    "argon2@0.45.1": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.6"
  }
}
